# bf_trader_py configuration
# Copy this file to .env and populate with real values before running the application.
# Never commit .env to version control — it contains real secrets.

# Betfair API credentials
BF_AppKey=your_betfair_app_key_here
BF_CRT_FILE=./certs/client-2048.crt
BF_KEY_FILE=./certs/client-2048.key
BF_USERID=your_betfair_username_here
BF_PWD=your_betfair_password_here

# PostgreSQL connection details
# DB_HOST uses the Docker container name "my_postgres" for the Postgres instance.
# In Docker: Docker DNS resolves this automatically for containers on "my_trading_network".
# For local development on Windows: add "127.0.0.1 my_postgres" to
#   C:\Windows\System32\drivers\etc\hosts (one-time setup, requires admin).
DB_HOST=my_postgres
DB_PORT=5432
DB_NAME=bf_trader
DB_USER=postgres
DB_PWD=your_postgres_password_here

# Raspberry Pi SSH access (SP-337)
# The always-on Pi on the local network. The assistant connects with key-based
# auth (no password), using the key at ~/.ssh/pi_kiro_assistant.
PI_HOST=your_pi_lan_ip_here
PI_USER=your_pi_username_here

# Betfair Telegram notifications — general-purpose "Betfair Issues" bot (SP-395).
# NOTE: SP-395's Rundeck job-failure alerts use EMAIL (via SMTP2GO), not these —
# Rundeck has no command/script notification plugin, so it cannot call a Telegram
# sender on failure (see docs/SP-395-rundeck-failure-telegram-notifications.md).
# This bot/module (logic/telegram_notify.py) is retained for OTHER notification
# needs (e.g. the Pi disk alert). A DEDICATED bot, separate from the trading
# project's SP-357 report-delivery bot. Create it via BotFather for the token,
# then get the chat id (message the bot and read getUpdates, or a chat-id helper
# bot). Both values are secrets — populate in .env, never commit .env.
TELEGRAM_BETFAIR_ISSUES_BOT_TOKEN=your_betfair_issues_bot_token_here
TELEGRAM_BETFAIR_ISSUES_CHAT_ID=your_betfair_issues_chat_id_here
